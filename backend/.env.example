# Quillora AI Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT_SECONDS=30.0

# Text Processing Limits
CHUNK_SIZE=1800
CHUNK_CONCURRENCY=4
MAX_TEXT_LENGTH=50000

# Optional MongoDB Connection (Privacy-first metadata logging only)
MONGODB_URI=
MONGODB_DB_NAME=quillora

# Server
HOST=0.0.0.0
PORT=8000
MOCK_LLM=false
