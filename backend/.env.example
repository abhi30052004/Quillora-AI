# Quillora AI Configuration Template
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT_SECONDS=35.0

# Text Processing Limits
CHUNK_SIZE=2200
CHUNK_CONCURRENCY=4
MAX_TEXT_LENGTH=50000

# Optional MongoDB Connection
MONGODB_URI=
MONGODB_DB_NAME=quillora

# Frontend Link & CORS
# In production on Render: set to your Vercel URL
FRONTEND_URL=https://quillora-ai.vercel.app

# Server
HOST=0.0.0.0
PORT=8000
MOCK_LLM=false
